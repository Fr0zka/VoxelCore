// VoxelGenerationCS.usf
// GPU compute shader for voxel terrain generation
// Implements the same generation logic as VoxelGenerator.cpp but runs on GPU

#include "/Engine/Public/Platform.ush"
#include "VoxelNoiseGPU.ush"

// ============================================================================
// SHADER PARAMETERS
// ============================================================================

// ============================================================================
// BIOME DATA STRUCTURE (must match CPU FBiomeTerrainParams layout)
// ============================================================================
struct BiomeData
{
    // Climate ranges for biome selection
    float TempMin;
    float TempMax;
    float MoistMin;
    float MoistMax;

    // Height parameters
    float HeightAmplitude;
    float HeightFrequency;
    int HeightOctaves;
    float HeightLacunarity;
    float HeightGain;

    // Mountain parameters
    float MountainAmplitude;
    float MountainFrequency;
    float MountainThreshold;
    float MountainSharpness;

    // 3D features
    float OverhangAmplitude;
    float OverhangFrequency;
    float WarpAmplitude;
    float WarpFrequency;
    float IslandAmplitude;
    float IslandFrequency;
    float IslandThreshold;
    float IslandBandCenterZ;
    float IslandBandHalfThickness;

    // Cave parameters
    float CaveDensity;
    float CaveFrequency2D;
    int CaveOctaves2D;
    float CaveLacunarity2D;
    float CaveGain2D;
    float CaveFrequency3D;
    int CaveOctaves3D;
};

// Chunk dimensions
uint SizeX;
uint SizeY;
uint SizeZ;

// World position offset
int BaseWX;
int BaseWY;
int BaseWZ;

// LOD scale (for LOD1 chunks, XY is scaled by this)
uint LODScaleXY;

// Generation settings
int WorldSeed;
int BaseHeight;
int WaterLevel;
int MaxCaveDepth;

// Biome array (structured buffer for dynamic number of biomes)
StructuredBuffer<BiomeData> Biomes;
uint BiomeCount;

// Output buffer - voxel categories (2 bits per voxel packed into bytes)
RWStructuredBuffer<uint> OutCategories;

// ============================================================================
// GENERATION FUNCTIONS
// ============================================================================

// Custom 2D fBm matching CPU implementation
float Sample01_2D_Custom(float x, float y, int octaves)
{
    float sum = 0.0;
    float maxAmp = 0.0;
    float amp = 1.0;
    float freq = 1.0;

    for (int i = 0; i < octaves; ++i)
    {
        sum += PerlinNoise2D(x * freq, y * freq) * amp;
        maxAmp += amp;
        freq *= HeightLacunarity;
        amp *= HeightGain;
    }

    // Normalize to [0,1]
    return (sum / maxAmp) * 0.5 + 0.5;
}

// Sample climate (Temperature and Moisture) for biome selection
// Matches CPU implementation in VoxelGenerator.cpp:46-61
void SampleClimate(float WX, float WY, out float outTemp, out float outMoist)
{
    // Simple Perlin-based climate (fallback when no NoiseProfile)
    // Matches CPU: fT = 1/256, fM = 1/192
    const float fT = 1.0 / 256.0;
    const float fM = 1.0 / 192.0;

    outTemp = clamp(PerlinNoise2D(WX * fT, WY * fT) * 0.5 + 0.5, 0.0, 1.0);
    outMoist = clamp(PerlinNoise2D(WX * fM, WY * fM) * 0.5 + 0.5, 0.0, 1.0);
}

// Pick biome based on temperature and moisture
// Matches CPU implementation in VoxelBiome.h:218-245 (BiomeTable::Pick)
int PickBiome(float Temp, float Moist)
{
    int bestBiome = 0;
    float bestDistance = 1000000.0;

    // First pass: Look for exact match (inside biome ranges)
    for (uint i = 0; i < BiomeCount; ++i)
    {
        BiomeData biome = Biomes[i];
        bool inside = (Temp >= biome.TempMin && Temp <= biome.TempMax) &&
                      (Moist >= biome.MoistMin && Moist <= biome.MoistMax);
        if (inside)
            return (int)i;
    }

    // Second pass: Find nearest biome by distance (fallback)
    for (uint i = 0; i < BiomeCount; ++i)
    {
        BiomeData biome = Biomes[i];

        // Clamp to biome's climate range
        float clampedT = clamp(Temp, biome.TempMin, biome.TempMax);
        float clampedM = clamp(Moist, biome.MoistMin, biome.MoistMax);

        // Calculate squared distance
        float dT = Temp - clampedT;
        float dM = Moist - clampedM;
        float dist2 = dT * dT + dM * dM;

        if (dist2 < bestDistance)
        {
            bestDistance = dist2;
            bestBiome = (int)i;
        }
    }

    return bestBiome;
}

// Compute macro surface height using PER-COLUMN biome selection
// Matches CPU implementation in VoxelGenerator.cpp:173-182
float MacroSurfaceZ_Biome(float x, float y)
{
    // Sample climate and pick biome for this XY column
    float Temp, Moist;
    SampleClimate(x, y, Temp, Moist);
    int biomeIdx = PickBiome(Temp, Moist);

    // Get biome-specific parameters
    BiomeData biome = Biomes[biomeIdx];

    // Base terrain height using biome-specific parameters
    float n01 = 0.5;
    if (biome.HeightOctaves > 0)
    {
        float sum = 0.0;
        float maxAmp = 0.0;
        float amp = 1.0;
        float freq = 1.0;

        for (int i = 0; i < biome.HeightOctaves; ++i)
        {
            sum += PerlinNoise2D(x * biome.HeightFrequency * freq, y * biome.HeightFrequency * freq) * amp;
            maxAmp += amp;
            freq *= biome.HeightLacunarity;
            amp *= biome.HeightGain;
        }
        n01 = (sum / maxAmp) * 0.5 + 0.5;
    }

    float H2D = BaseHeight + (n01 - 0.5) * 2.0 * biome.HeightAmplitude;

    // Mountains using biome-specific parameters
    if (biome.MountainAmplitude > 0.0)
    {
        float r = Ridged2D(
            x * biome.MountainFrequency + WorldSeed * 0.13,
            y * biome.MountainFrequency + WorldSeed * 0.19
        );

        float band = max(0.0, r - biome.MountainThreshold);
        float shaped = pow(band, biome.MountainSharpness);
        float M = biome.MountainAmplitude * shaped;

        H2D += M;
    }

    return H2D;
}

// Check if a voxel is carved by caves (using per-column biome parameters)
bool IsCave_Biome(float x, float y, float zWorld, float terrainH)
{
    // Sample climate and pick biome for this XY column (same as MacroSurfaceZ_Biome)
    float Temp, Moist;
    SampleClimate(x, y, Temp, Moist);
    int biomeIdx = PickBiome(Temp, Moist);

    // Get biome-specific cave parameters
    BiomeData biome = Biomes[biomeIdx];

    if (biome.CaveDensity <= 0.0)
        return false;

    float depth = terrainH - zWorld;
    if (depth < 2.0)
        return false;

    // Surface modifier
    float surf = clamp(1.0 - depth / 24.0, 0.0, 1.0);

    // 2D cave mask using biome-specific parameters
    float sx = x * biome.CaveFrequency2D;
    float sy = y * biome.CaveFrequency2D;
    float sum = 0.0;
    float maxAmp = 0.0;
    float amp = 1.0;
    float freq = 1.0;

    for (int i = 0; i < biome.CaveOctaves2D; ++i)
    {
        sum += PerlinNoise2D(sx * freq, sy * freq) * amp;
        maxAmp += amp;
        freq *= biome.CaveLacunarity2D;
        amp *= biome.CaveGain2D;
    }

    float t2d = (sum / maxAmp) * 0.5 + 0.5;
    float th2d = 0.68 - 0.10 * surf;

    bool mask = (t2d > th2d / biome.CaveDensity);
    if (!mask)
        return false;

    // 3D cave tube using biome-specific parameters
    float sx3d = x * biome.CaveFrequency3D;
    float sy3d = y * biome.CaveFrequency3D;
    float sz3d = zWorld * biome.CaveFrequency3D;
    float sum3d = 0.0;
    float maxAmp3d = 0.0;
    float amp3d = 1.0;
    float freq3d = 1.0;

    for (int j = 0; j < biome.CaveOctaves3D; ++j)
    {
        sum3d += PerlinNoise3D(sx3d * freq3d, sy3d * freq3d, sz3d * freq3d) * amp3d;
        maxAmp3d += amp3d;
        freq3d *= biome.CaveLacunarity2D;
        amp3d *= biome.CaveGain2D;
    }

    float n3d = abs(sum3d / maxAmp3d);
    float k = clamp(depth / 96.0, 0.0, 1.0);
    float baseRad = lerp(0.12, 0.20, k);
    float rad = baseRad * sqrt(biome.CaveDensity); // CRITICAL: Apply density scaling to match CPU

    return (n3d < rad);
}

// Compute 3D density at a world position (using per-column biome parameters)
float Density3D_FromMacro_Biome(float x, float y, float zWorld, float macroHeight)
{
    // Sample climate and pick biome for this XY column
    float Temp, Moist;
    SampleClimate(x, y, Temp, Moist);
    int biomeIdx = PickBiome(Temp, Moist);

    // Get biome-specific 3D feature parameters
    BiomeData biome = Biomes[biomeIdx];

    // Domain warp
    float3 pw = DomainWarp3D(x, y, zWorld, biome.WarpAmplitude, biome.WarpFrequency, WorldSeed);

    // Overhangs using biome-specific parameters
    float Overhang = biome.OverhangAmplitude * PerlinNoise3D(
        pw.x * biome.OverhangFrequency,
        pw.y * biome.OverhangFrequency,
        pw.z * biome.OverhangFrequency
    );

    // Floating islands using biome-specific parameters (band restricts altitude range)
    float iband = 1.0 - clamp(abs(zWorld - biome.IslandBandCenterZ) / max(1.0, biome.IslandBandHalfThickness), 0.0, 1.0);
    float islandField = 1.0 - abs(PerlinNoise3D(
        pw.x * biome.IslandFrequency + 11.3,
        pw.y * biome.IslandFrequency + 27.1,
        pw.z * biome.IslandFrequency - 5.7
    ));
    float Islands = iband * ((islandField - biome.IslandThreshold) * biome.IslandAmplitude);

    // Combine
    float D = macroHeight - zWorld;
    D += Overhang;

    // Only union islands if floating above macro surface
    if (zWorld >= macroHeight + 6.0)
    {
        D = max(D, Islands);
    }

    return D;
}

// ============================================================================
// MAIN COMPUTE SHADER
// ============================================================================

[numthreads(4, 4, 4)]
void GenerateVoxelChunk(uint3 ThreadId : SV_DispatchThreadID)
{
    // Check bounds
    if (ThreadId.x >= SizeX || ThreadId.y >= SizeY || ThreadId.z >= SizeZ)
        return;

    // Compute world position (accounting for -1 halo padding)
    // ThreadId ranges from [0, SizeX-1] but represents voxel indices [-1, SizeX-2]
    // BaseWX/Y/Z = world coordinate of chunk origin (voxel index 0)
    int WX = BaseWX + ((int)ThreadId.x - 1) * (int)LODScaleXY;
    int WY = BaseWY + ((int)ThreadId.y - 1) * (int)LODScaleXY;
    int WZ = BaseWZ + ((int)ThreadId.z - 1);

    float Z = (float)WZ;

    uint Category = 0;

    // ========================================================================
    // DEBUG MODE OPTIONS:
    // 0 = Full terrain generation
    // 1 = Checkerboard pattern (verify shader compilation)
    // 2 = Simple Perlin test (verify noise implementation)
    // ========================================================================
    #define DEBUG_MODE 0

    #if DEBUG_MODE == 1

    // CHECKERBOARD PATTERN: Alternating solid/air every other voxel
    // This creates an obvious visual pattern that's impossible to miss
    // If you see ANY terrain generation that's not a perfect checkerboard,
    // the shader DID NOT RECOMPILE and is using cached/old code!
    bool isCheckerboard = ((WX + WY + WZ) & 1) == 0;

    if (isCheckerboard)
    {
        Category = 2; // Solid (checkerboard squares)
    }
    else
    {
        Category = 0; // Air (empty squares)
    }

    #elif DEBUG_MODE == 2

    // SIMPLE PERLIN TEST: Use raw Perlin noise to generate height
    // This isolates the Perlin implementation from all other terrain logic
    float perlinValue = PerlinNoise2D((float)WX * 0.01, (float)WY * 0.01);  // [-1, 1]
    float testHeight = BaseHeight + perlinValue * 20.0;  // Simple height variation

    if (WZ <= testHeight)
    {
        Category = 2; // Solid
    }
    else if (WZ <= WaterLevel)
    {
        Category = 1; // Water
    }
    else
    {
        Category = 0; // Air
    }

    #else

    // ========================================================================
    // FULL GENERATION (production code)
    // ========================================================================

    // Compute macro surface height
    float M = MacroSurfaceZ_Biome((float)WX, (float)WY);

    // Sample climate and pick biome for narrow band optimization
    float Temp, Moist;
    SampleClimate((float)WX, (float)WY, Temp, Moist);
    int biomeIdx = PickBiome(Temp, Moist);
    BiomeData biome = Biomes[biomeIdx];

    // Compute margin for narrow band optimization using biome-specific parameters
    float Margin = biome.OverhangAmplitude + biome.IslandAmplitude + 3.0;
    float D0 = M - Z;

    // Far above surface - air or water
    if (D0 < -Margin)
    {
        Category = (Z <= (float)WaterLevel) ? 1 : 0;
    }
    // Deep below surface - could be solid or cave
    else if (D0 > Margin)
    {
        float D = Density3D_FromMacro_Biome((float)WX, (float)WY, Z, M);
        if (D > 0.0)
        {
            // OPTIMIZATION: Skip cave checks if too deep (using biome-specific cave density)
            float DepthFromSurface = M - Z;
            bool bCheckCaves = (biome.CaveDensity > 0.0) && (DepthFromSurface <= (float)MaxCaveDepth);

            if (bCheckCaves && IsCave_Biome((float)WX, (float)WY, Z, M))
                Category = 0; // Cave
            else
                Category = 2; // Solid
        }
        else
        {
            Category = (Z <= (float)WaterLevel) ? 1 : 0;
        }
    }
    // Narrow band - full density evaluation
    else
    {
        float D = Density3D_FromMacro_Biome((float)WX, (float)WY, Z, M);
        if (D > 0.0)
        {
            // OPTIMIZATION: Narrow band cave checks (using biome-specific cave density)
            float DepthFromSurface = M - Z;
            bool bCheckCaves = (biome.CaveDensity > 0.0) && (DepthFromSurface <= (float)MaxCaveDepth);

            if (bCheckCaves && IsCave_Biome((float)WX, (float)WY, Z, M))
                Category = 0; // Cave
            else
                Category = 2; // Solid
        }
        else
        {
            Category = (Z <= (float)WaterLevel) ? 1 : 0;
        }
    }

    #endif // End debug mode / full generation

    // Pack category into output buffer (2 bits per voxel)
    // The buffer is uint32[], but we're packing to match CPU's byte-array layout
    // 4 voxels per byte = 16 voxels per uint32
    uint LinearIndex = ThreadId.x + ThreadId.y * SizeX + ThreadId.z * SizeX * SizeY;
    uint BitIndex = LinearIndex * 2;  // Each voxel uses 2 bits
    uint Uint32Index = BitIndex / 32; // Which uint32 in the buffer
    uint BitOffset = BitIndex % 32;   // Bit position within that uint32

    // Fast atomic write (buffer is pre-cleared to zero)
    // Category 0 (air) is already zero, so skip write
    // For non-zero categories, just OR the bits in atomically
    if (Category != 0)
    {
        uint Value = Category << BitOffset;
        InterlockedOr(OutCategories[Uint32Index], Value);
    }
}
