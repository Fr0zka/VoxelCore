// VoxelNoiseGPU.ush
// GPU-optimized noise library for voxel terrain generation
// Implements Perlin noise and fractional Brownian motion (fBm)

#ifndef VOXEL_NOISE_GPU_USH
#define VOXEL_NOISE_GPU_USH

// ============================================================================
// PERMUTATION TABLE FOR PERLIN NOISE
// ============================================================================
// Unreal Engine's permutation table (from Engine/Source/Runtime/Core/Private/Math/UnrealMath.cpp)
// This MUST match exactly for identical noise output!
static const uint PermTable[256] = {
    63, 9, 212, 205, 31, 128, 72, 59, 137, 203, 195, 170, 181, 115, 165, 40, 116, 139, 175, 225, 132, 99, 222, 2, 41, 15, 197, 93, 169, 90, 228, 43,
    221, 38, 206, 204, 73, 17, 97, 10, 96, 47, 32, 138, 136, 30, 219, 78, 224, 13, 193, 88, 134, 211, 7, 112, 176, 19, 106, 83, 75, 217, 85, 0,
    98, 140, 229, 80, 118, 151, 117, 251, 103, 242, 81, 238, 172, 82, 110, 4, 227, 77, 243, 46, 12, 189, 34, 188, 200, 161, 68, 76, 171, 194, 57, 48,
    247, 233, 51, 105, 5, 23, 42, 50, 216, 45, 239, 148, 249, 84, 70, 125, 108, 241, 62, 66, 64, 240, 173, 185, 250, 49, 6, 37, 26, 21, 244, 60,
    223, 255, 16, 145, 27, 109, 58, 102, 142, 253, 120, 149, 160, 124, 156, 79, 186, 135, 127, 14, 121, 22, 65, 54, 153, 91, 213, 174, 24, 252, 131, 192,
    190, 202, 208, 35, 94, 231, 56, 95, 183, 163, 111, 147, 25, 67, 36, 92, 236, 71, 166, 1, 187, 100, 130, 143, 237, 178, 158, 104, 184, 159, 177, 52,
    214, 230, 119, 87, 114, 201, 179, 198, 3, 248, 182, 39, 11, 152, 196, 113, 20, 232, 69, 141, 207, 234, 53, 86, 180, 226, 74, 150, 218, 29, 133, 8,
    44, 123, 28, 146, 89, 101, 154, 220, 126, 155, 122, 210, 168, 254, 162, 129, 33, 18, 209, 61, 191, 199, 157, 245, 55, 164, 167, 215, 246, 144, 107, 235
};

// ============================================================================
// HELPER FUNCTIONS
// ============================================================================

// Fast floor function for GPU
float FastFloor(float x)
{
    return floor(x);
}

// Fade function for smooth interpolation (6t^5 - 15t^4 + 10t^3)
float Fade(float t)
{
    return t * t * t * (t * (t * 6.0 - 15.0) + 10.0);
}

// Linear interpolation
float Lerp(float t, float a, float b)
{
    return a + t * (b - a);
}

// Gradient function - computes dot product of gradient vector and distance vector
float Grad(int hash, float x, float y, float z)
{
    int h = hash & 15;
    float u = h < 8 ? x : y;
    float v = h < 4 ? y : ((h == 12 || h == 14) ? x : z);
    return ((h & 1) == 0 ? u : -u) + ((h & 2) == 0 ? v : -v);
}

// 2D gradient - EXACTLY matches Unreal's FMath::PerlinNoise2D
// From Engine/Source/Runtime/Core/Private/Math/UnrealMath.cpp
// Uses 8 directions: 4 cardinal + 4 diagonal
float Grad2D(int hash, float x, float y)
{
    // Unreal uses 8 gradient directions (Hash & 7)
    switch (hash & 7)
    {
        case 0: return x;        // (1, 0)
        case 1: return x + y;    // (1, 1)
        case 2: return y;        // (0, 1)
        case 3: return -x + y;   // (-1, 1)
        case 4: return -x;       // (-1, 0)
        case 5: return -x - y;   // (-1, -1)
        case 6: return -y;       // (0, -1)
        case 7: return x - y;    // (1, -1)
        default: return 0;       // Should never happen
    }
}

// Hash lookup with wrapping
uint Hash(int i)
{
    return PermTable[i & 255];
}

// ============================================================================
// PERLIN NOISE 2D
// ============================================================================
float PerlinNoise2D(float x, float y)
{
    // Find unit square that contains point
    int X = (int)FastFloor(x) & 255;
    int Y = (int)FastFloor(y) & 255;

    // Find relative x,y in square
    x -= FastFloor(x);
    y -= FastFloor(y);

    // Compute fade curves
    float u = Fade(x);
    float v = Fade(y);

    // Hash coordinates of square corners
    int A = Hash(X) + Y;
    int B = Hash(X + 1) + Y;

    // Blend results from 4 corners
    float res = Lerp(v,
        Lerp(u, Grad2D(Hash(A), x, y), Grad2D(Hash(B), x - 1, y)),
        Lerp(u, Grad2D(Hash(A + 1), x, y - 1), Grad2D(Hash(B + 1), x - 1, y - 1))
    );

    // Return raw result - let's match Unreal's actual output range
    // Testing shows this produces similar range to FMath::PerlinNoise2D
    return res;
}

// ============================================================================
// PERLIN NOISE 3D
// ============================================================================
float PerlinNoise3D(float x, float y, float z)
{
    // Find unit cube that contains point
    int X = (int)FastFloor(x) & 255;
    int Y = (int)FastFloor(y) & 255;
    int Z = (int)FastFloor(z) & 255;

    // Find relative x,y,z in cube
    x -= FastFloor(x);
    y -= FastFloor(y);
    z -= FastFloor(z);

    // Compute fade curves
    float u = Fade(x);
    float v = Fade(y);
    float w = Fade(z);

    // Hash coordinates of cube corners
    int A = Hash(X) + Y;
    int AA = Hash(A) + Z;
    int AB = Hash(A + 1) + Z;
    int B = Hash(X + 1) + Y;
    int BA = Hash(B) + Z;
    int BB = Hash(B + 1) + Z;

    // Blend results from 8 corners of cube
    float res = Lerp(w,
        Lerp(v,
            Lerp(u, Grad(Hash(AA), x, y, z), Grad(Hash(BA), x - 1, y, z)),
            Lerp(u, Grad(Hash(AB), x, y - 1, z), Grad(Hash(BB), x - 1, y - 1, z))
        ),
        Lerp(v,
            Lerp(u, Grad(Hash(AA + 1), x, y, z - 1), Grad(Hash(BA + 1), x - 1, y, z - 1)),
            Lerp(u, Grad(Hash(AB + 1), x, y - 1, z - 1), Grad(Hash(BB + 1), x - 1, y - 1, z - 1))
        )
    );

    return res;
}

// ============================================================================
// FRACTIONAL BROWNIAN MOTION (fBm)
// ============================================================================

// fBm 2D - Sums multiple octaves of Perlin noise
float fBm2D(float x, float y, int octaves, float lacunarity, float gain)
{
    float amplitude = 1.0;
    float frequency = 1.0;
    float sum = 0.0;
    float maxAmplitude = 0.0;

    for (int i = 0; i < octaves; ++i)
    {
        sum += amplitude * PerlinNoise2D(x * frequency, y * frequency);
        maxAmplitude += amplitude;
        amplitude *= gain;
        frequency *= lacunarity;
    }

    // Normalize to [0,1]
    return (sum / maxAmplitude) * 0.5 + 0.5;
}

// fBm 3D - Sums multiple octaves of Perlin noise
float fBm3D(float x, float y, float z, int octaves, float lacunarity, float gain)
{
    float amplitude = 1.0;
    float frequency = 1.0;
    float sum = 0.0;
    float maxAmplitude = 0.0;

    for (int i = 0; i < octaves; ++i)
    {
        sum += amplitude * PerlinNoise3D(x * frequency, y * frequency, z * frequency);
        maxAmplitude += amplitude;
        amplitude *= gain;
        frequency *= lacunarity;
    }

    // Return [-1, 1]
    return sum / maxAmplitude;
}

// ============================================================================
// RIDGED NOISE
// ============================================================================

// Ridged noise 2D - inverted absolute Perlin
float Ridged2D(float x, float y)
{
    return 1.0 - abs(PerlinNoise2D(x, y));
}

// Ridged noise 3D - inverted absolute Perlin
float Ridged3D(float x, float y, float z)
{
    return 1.0 - abs(PerlinNoise3D(x, y, z));
}

// ============================================================================
// DOMAIN WARPING
// ============================================================================

// 3D domain warping - displaces coordinates using Perlin noise
float3 DomainWarp3D(float x, float y, float z, float amplitude, float frequency, float seed)
{
    if (amplitude <= 0.0)
        return float3(x, y, z);

    float ox = seed * 0.17;
    float oy = seed * 0.29;
    float oz = seed * 0.41;

    float wx = PerlinNoise3D((x + ox) * frequency, y * frequency, z * frequency);
    float wy = PerlinNoise3D(x * frequency, (y + oy) * frequency, z * frequency);
    float wz = PerlinNoise3D(x * frequency, y * frequency, (z + oz) * frequency);

    return float3(x + wx * amplitude, y + wy * amplitude, z + wz * amplitude);
}

// ============================================================================
// UTILITY FUNCTIONS
// ============================================================================

// Saturate (clamp to [0,1])
float Saturate01(float v)
{
    return clamp(v, 0.0, 1.0);
}

// Smooth Hermite interpolation
float SmoothStep01(float a, float b, float x)
{
    float t = Saturate01((x - a) / (b - a));
    return t * t * (3.0 - 2.0 * t);
}

#endif // VOXEL_NOISE_GPU_USH
