# Ignore everything
*

# But keep this gitignore file
!.gitignore


# Keep Source folder and its contents
!/Source/
!/Source/**

# The guarded single-entry test harness is source, not generated output.
!/Tools/
!/Tools/**
/Tools/**/__pycache__/

# Closed / historical documents.
!/Docs/
!/Docs/**

!VoxelForge.uplugin

# Keep every design / doc markdown at any depth
!*.md
